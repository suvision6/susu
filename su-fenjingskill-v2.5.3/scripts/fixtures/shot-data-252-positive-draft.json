  "director_style_options": [
    {
      "label": "行为控制下的心理压迫（参考大卫·芬奇）",
      "option_id": "STYLE-01",
      "profile": {
        "camera_energy": "responsive",
        "natural_language_intent": "摄影机克制靠近人物，不抢表演。",
        "performance_focus": "face",
        "priorities": [
          "保留问话后的停顿",
          "让空间在人物关系中显露"
        ],
        "rhythm": "restrained",
        "space_strategy": "embedded_reveal",
        "transition_language": [
          "gaze_cut",
          "long_hold",
          "action_cut"
        ],
        "visual_distance": "intimate"
      },
      "rationale": "适配依据：两人的试探由可见行为和信息控制推进。\n时间与剪辑：保留问句后的停顿，在周抬眼时转移观看权。\n摄影机：克制响应动作，不用运动替代压力。\n空间与调度：在门口与桌边的距离中显露控制关系。\n表演与观看：贴近周抬眼和握钥匙的微小行为。\n主要收益：让心理压力落到可见证据。\n主要风险：过度冷控可能削弱未知声源的不安。"
    },
    {
      "label": "家庭日常中的反应余波（参考是枝裕和）",
      "option_id": "STYLE-02",
      "profile": {
        "camera_energy": "static",
        "natural_language_intent": "保持观察距离，以完整身体动作建立空间。",
        "performance_focus": "body",
        "priorities": [
          "先建立人物空间关系",
          "让动作承担节奏变化"
        ],
        "rhythm": "balanced",
        "space_strategy": "establish_then_enter",
        "transition_language": [
          "hard_cut"
        ],
        "visual_distance": "observational"
      },
      "rationale": "适配依据：日常空间和迟到反应可以承载关系。\n时间与剪辑：让完整身体动作自然决定停留与切点。\n摄影机：保持观察距离，少于演员主动。\n空间与调度：先建立门口与桌边的共同空间。\n表演与观看：观看倾听、抬眼和握紧后的余波。\n主要收益：保留关系的生活质感。\n主要风险：可能减弱来源里的悬疑压力。"
    },
    {
      "label": "日常裂缝中的梦境恐惧（参考大卫·林奇）",
      "option_id": "STYLE-03",
      "profile": {
        "camera_energy": "assertive",
        "natural_language_intent": "让摄影机被未知声源牵引，以空间变化放大试探。",
        "performance_focus": "blocking",
        "priorities": [
          "让声源牵引观看位置",
          "用人物走位重组空间压力"
        ],
        "rhythm": "kinetic",
        "space_strategy": "subjective",
        "transition_language": [
          "sound_bridge",
          "action_cut"
        ],
        "visual_distance": "mixed"
      },
      "rationale": "适配依据：未知声源可让普通室内逐渐失去安全感。\n时间与剪辑：延迟解释，用停顿和声音维持不适。\n摄影机：允许被声源牵引的缓慢、主观响应。\n空间与调度：让门口、桌边与画外声源形成断裂。\n表演与观看：观看周的迟疑和身体紧缩。\n主要收益：放大无法解释的恐惧。\n主要风险：若过度神秘化会损害事件清楚度。"
    }
  ],
