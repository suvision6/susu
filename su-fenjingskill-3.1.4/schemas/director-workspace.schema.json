        "note": {
          "$ref": "#/$defs/nonEmpty"
        },
        "timestamp_utc": {
          "type": "string",
          "minLength": 1
        },
        "previous_event_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
