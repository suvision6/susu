      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "gap_id",
        "resolution",
        "assumption_id",
        "reference_fact_id"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^AO[0-9]{3,}$"
