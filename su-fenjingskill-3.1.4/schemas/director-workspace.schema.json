        "gap_id": {
          "type": "string",
          "pattern": "^SG[0-9]{3,}$"
        },
        "resolution": {
          "enum": [
            "assumption_required",
            "supplemental_source_confirmed"
          ]
        },
        "assumption_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^A[0-9]{3,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_fact_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^RF[0-9]{3,}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "approvalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "content_hash",
        "reviewer",
        "note",
        "timestamp_utc",
        "previous_event_hash",
        "event_hash"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^AE[0-9]{3,}$"
