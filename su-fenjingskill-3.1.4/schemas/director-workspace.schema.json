{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suvision.example/schemas/director-workspace-3.1.4.json",
  "title": "director-workspace/3.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_contract",
    "source",
    "format_brief",
    "gate_0",
    "supplemental_reference_facts",
    "assumption_obligations",
    "director_method",
    "gate_1",
    "scene_strategies",
    "shot_bindings",
    "director_inferences",
    "approval_events",
    "review_lock"
  ],
  "properties": {
    "workspace_contract": {
      "const": "director-workspace/3.1.4"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "format_brief": {
      "$ref": "#/$defs/formatBrief"
    },
    "gate_0": {
      "$ref": "#/$defs/gateZero"
    },
    "director_method": {
      "$ref": "#/$defs/directorMethod"
    },
    "gate_1": {
      "$ref": "#/$defs/gateOne"
    },
    "scene_strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sceneStrategy"
      }
    },
    "shot_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shotBinding"
      }
    },
    "supplemental_reference_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supplementalReferenceFact"
      }
    },
    "director_inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/directorInference"
      }
    },
    "review_lock": {
      "$ref": "#/$defs/reviewLock"
    },
    "assumption_obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumptionObligation"
      }
    },
    "approval_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approvalEvent"
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "dialoguePaceOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["override_id", "scope", "scope_ref", "selected_cps", "strong_pause_seconds", "soft_pause_seconds", "reason"],
      "properties": {
        "override_id": {"type": "string", "pattern": "^PO[0-9]{3,}$"},
        "scope": {"enum": ["scene", "character", "dialogue"]},
        "scope_ref": {"$ref": "#/$defs/nonEmpty"},
        "selected_cps": {"type": "number", "exclusiveMinimum": 0},
        "strong_pause_seconds": {"type": "number", "minimum": 0},
        "soft_pause_seconds": {"type": "number", "minimum": 0},
        "reason": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "dialoguePace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard_id", "pace_profile", "rate_basis", "range_min_cps", "range_max_cps", "default_cps", "selected_cps", "strong_pause_seconds", "soft_pause_seconds", "basis", "overrides"],
      "properties": {
        "standard_id": {"enum": ["su-dialogue-pace/1.0", "unresolved"]},
        "pace_profile": {"enum": ["fast", "natural", "deliberate", "variable", "custom", "unresolved"]},
        "rate_basis": {"enum": ["articulation_rate_excluding_pauses", "unresolved"]},
        "range_min_cps": {"type": "number", "minimum": 0},
        "range_max_cps": {"type": "number", "minimum": 0},
        "default_cps": {"type": "number", "minimum": 0},
        "selected_cps": {"type": "number", "minimum": 0},
        "strong_pause_seconds": {"type": "number", "minimum": 0},
        "soft_pause_seconds": {"type": "number", "minimum": 0},
        "basis": {"$ref": "#/$defs/nonEmpty"},
        "overrides": {"type": "array", "items": {"$ref": "#/$defs/dialoguePaceOverride"}}
      }
    },
    "formatBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rhythm_profile", "target_runtime_seconds", "aspect_ratio", "orientation", "dialogue_pace", "coverage_bias", "confirmation_note"],
      "properties": {
        "rhythm_profile": {
          "enum": ["short_drama_under_10m", "platform_series_episode", "short_film_3_20m", "feature_film", "custom", "unresolved"]
        },
        "target_runtime_seconds": {"type": "number", "minimum": 0},
        "aspect_ratio": {"enum": ["9:16", "16:9", "1.85:1", "2.35:1", "2.39:1", "4:3", "custom", "unresolved"]},
        "orientation": {"enum": ["vertical", "horizontal", "custom", "unresolved"]},
        "dialogue_pace": {"$ref": "#/$defs/dialoguePace"},
        "coverage_bias": {"$ref": "#/$defs/nonEmpty"},
        "confirmation_note": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "gateZero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "format_hash", "note"],
      "properties": {
        "status": {"enum": ["confirmed", "pending", "invalidated"]},
        "format_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "note": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_start",
        "line_end"
      ],
      "properties": {
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "authorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performance_authority",
        "reference_languages",
        "bilingual_relation",
        "authority_basis"
      ],
      "properties": {
        "performance_authority": {
          "$ref": "#/$defs/nonEmpty"
        },
        "reference_languages": {
          "$ref": "#/$defs/stringArray"
        },
        "bilingual_relation": {
          "enum": [
            "literal_equivalent",
            "adapted_equivalent",
            "independent"
          ]
        },
        "authority_basis": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "scope_kind",
        "authority_line_ranges",
        "reference_line_ranges"
      ],
      "properties": {
        "scope_id": {
          "anyOf": [
            {
              "const": "GLOBAL"
            },
            {
              "type": "string",
              "pattern": "^SC[0-9]{3,}$"
            }
          ]
        },
        "scope_kind": {
          "enum": [
            "global",
            "scene"
          ]
        },
        "authority_line_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineRange"
          }
        },
        "reference_line_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineRange"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked_text",
        "source_hash",
        "authority_policy",
        "scopes",
        "source_units",
        "classification_reviews",
        "source_gaps",
        "source_passages",
        "source_facts"
      ],
      "properties": {
        "locked_text": {
          "$ref": "#/$defs/nonEmpty"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authority_policy": {
          "$ref": "#/$defs/authorityPolicy"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "source_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceUnit"
          }
        },
        "source_passages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourcePassage"
          }
        },
        "source_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceFact"
          }
        },
        "classification_reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classificationReview"
          }
        },
        "source_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceGap"
          }
        }
      }
    },
    "sourceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "scope_id",
        "line_start",
        "line_end",
        "kind",
        "language",
        "authority_role",
        "exact_text",
        "semantic_summary"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^SU[0-9]{3,}$"
        },
        "scope_id": {
          "anyOf": [
            {
              "const": "GLOBAL"
            },
            {
              "type": "string",
              "pattern": "^SC[0-9]{3,}$"
            }
          ]
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "scene_heading",
            "action",
            "dialogue",
            "stage_direction",
            "source_sound",
            "transition",
            "metadata"
          ]
        },
        "language": {
          "$ref": "#/$defs/nonEmpty"
        },
        "authority_role": {
          "enum": [
            "performance_authority",
            "adapted_reference",
            "non_narrative"
          ]
        },
        "exact_text": {
          "$ref": "#/$defs/nonEmpty"
        },
        "speaker": {
          "type": "string"
        },
        "voice_type": {
          "enum": [
            "scene_dialogue",
            "vo",
            "mediated",
            "unresolved"
          ]
        },
        "dialogue_id": {
          "type": "string",
          "pattern": "^D[0-9]{3,}$"
        },
        "semantic_summary": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "sourcePassage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passage_id",
        "scope_id",
        "source_unit_ids",
        "coverage_status",
        "shot_refs",
        "reason"
      ],
      "properties": {
        "passage_id": {
          "type": "string",
          "pattern": "^SP[0-9]{3,}$"
        },
        "scope_id": {
          "anyOf": [
            {
              "const": "GLOBAL"
            },
            {
              "type": "string",
              "pattern": "^SC[0-9]{3,}$"
            }
          ]
        },
        "source_unit_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "coverage_status": {
          "enum": [
            "covered",
            "intentionally_withheld",
            "intentionally_omitted"
          ]
        },
        "shot_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SH[0-9]{3,}$"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "passage_id",
        "source_unit_ids",
        "source_span",
        "kind",
        "subjects",
        "predicate",
        "objects",
        "polarity",
        "qualifiers",
        "importance",
        "anchors",
        "cause_fact_ids",
        "effect_fact_ids"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^SF[0-9]{3,}$"
        },
        "passage_id": {
          "type": "string",
          "pattern": "^SP[0-9]{3,}$"
        },
        "source_unit_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "source_span": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "enum": [
            "entity_attribute",
            "action",
            "action_result",
            "state",
            "negation",
            "causal_link",
            "relation",
            "source_sound",
            "reality_change",
            "world_rule"
          ]
        },
        "subjects": {
          "$ref": "#/$defs/stringArray"
        },
        "predicate": {
          "$ref": "#/$defs/nonEmpty"
        },
        "objects": {
          "$ref": "#/$defs/stringArray"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "qualifiers": {
          "$ref": "#/$defs/stringArray"
        },
        "importance": {
          "enum": [
            "required",
            "supporting"
          ]
        },
        "anchors": {
          "$ref": "#/$defs/stringArray"
        },
        "cause_fact_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "effect_fact_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "factRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "mode",
        "execution_span",
        "subject_owners",
        "result_span",
        "polarity"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^SF[0-9]{3,}$"
        },
        "mode": {
          "enum": [
            "visual",
            "dialogue",
            "sound",
            "offscreen"
          ]
        },
        "execution_span": {
          "$ref": "#/$defs/nonEmpty"
        },
        "subject_owners": {
          "$ref": "#/$defs/stringArray"
        },
        "result_span": {
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        }
      }
    },
    "shotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "passage_ids",
        "fact_realizations",
        "director_inference_ids",
        "offscreen_subjects"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "pattern": "^SH[0-9]{3,}$"
        },
        "passage_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "fact_realizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factRealization"
          }
        },
        "director_inference_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "offscreen_subjects": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "supplementalReferenceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_fact_id",
        "statement",
        "source_excerpt",
        "source_hash",
        "provenance",
        "approval_status",
        "approval_hash",
        "approval_note"
      ],
      "properties": {
        "reference_fact_id": {
          "type": "string",
          "pattern": "^RF[0-9]{3,}$"
        },
        "statement": {
          "$ref": "#/$defs/nonEmpty"
        },
        "source_excerpt": {
          "$ref": "#/$defs/nonEmpty"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_type",
            "source_title",
            "locator",
            "owner"
          ],
          "properties": {
            "source_type": {
              "enum": [
                "user_supplied",
                "document",
                "film_reference",
                "research",
                "other"
              ]
            },
            "source_title": {
              "$ref": "#/$defs/nonEmpty"
            },
            "locator": {
              "$ref": "#/$defs/nonEmpty"
            },
            "owner": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        },
        "approval_status": {
          "enum": [
            "approved",
            "pending",
            "rejected"
          ]
        },
        "approval_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_note": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "directorInference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_id",
        "scope",
        "statement",
        "basis_fact_ids",
        "reference_fact_ids",
        "shot_refs",
        "reversibility",
        "status",
        "conflicts_with_fact_ids"
      ],
      "properties": {
        "inference_id": {
          "type": "string",
          "pattern": "^DI[0-9]{3,}$"
        },
        "scope": {
          "$ref": "#/$defs/nonEmpty"
        },
        "statement": {
          "$ref": "#/$defs/nonEmpty"
        },
        "basis_fact_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "reference_fact_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "shot_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SH[0-9]{3,}$"
          }
        },
        "reversibility": {
          "enum": [
            "reversible",
            "confirmation_required"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "rejected"
          ]
        },
        "conflicts_with_fact_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "mechanism": {
      "enum": [
        "relationship_accumulation",
        "information_suspense",
        "offscreen_threat",
        "comedy_setup_payoff",
        "action_causality",
        "ensemble_power",
        "ritual_repetition",
        "montage_music_concept",
        "subjective_memory",
        "spectacle_discovery"
      ]
    },
    "directorMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "method_name",
        "reference_source",
        "applicability",
        "time_model",
        "base_editing_unit",
        "boundary_priorities",
        "hold_policy",
        "montage_intercut_policy",
        "viewpoint_knowledge",
        "space_reveal",
        "performance_editing",
        "camera_agency",
        "sound_image_relation",
        "continuity_attitude",
        "mechanism_adaptation",
        "preferred_patterns",
        "avoid_patterns",
        "exception_conditions"
      ],
      "properties": {
        "method_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "method_name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "reference_source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "applicability": {
          "$ref": "#/$defs/nonEmpty"
        },
        "time_model": {
          "$ref": "#/$defs/nonEmpty"
        },
        "base_editing_unit": {
          "$ref": "#/$defs/nonEmpty"
        },
        "boundary_priorities": {
          "$ref": "#/$defs/nonEmpty"
        },
        "hold_policy": {
          "$ref": "#/$defs/nonEmpty"
        },
        "montage_intercut_policy": {
          "$ref": "#/$defs/nonEmpty"
        },
        "viewpoint_knowledge": {
          "$ref": "#/$defs/nonEmpty"
        },
        "space_reveal": {
          "$ref": "#/$defs/nonEmpty"
        },
        "performance_editing": {
          "$ref": "#/$defs/nonEmpty"
        },
        "camera_agency": {
          "$ref": "#/$defs/nonEmpty"
        },
        "sound_image_relation": {
          "$ref": "#/$defs/nonEmpty"
        },
        "continuity_attitude": {
          "$ref": "#/$defs/nonEmpty"
        },
        "mechanism_adaptation": {
          "$ref": "#/$defs/nonEmpty"
        },
        "preferred_patterns": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "avoid_patterns": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "exception_conditions": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "gateOne": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "method_hash",
        "note"
      ],
      "properties": {
        "mode": {
          "enum": [
            "user_specified",
            "confirmed",
            "required",
            "invalidated"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "pending",
            "invalidated"
          ]
        },
        "method_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "boundaryToNext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "trigger",
        "editorial_gain"
      ],
      "properties": {
        "relation": {
          "enum": [
            "cut",
            "reaction_cut",
            "action_cut",
            "gaze_cut",
            "match_cut",
            "jump_cut",
            "ellipsis",
            "intercut",
            "montage",
            "sound_lead",
            "sound_lag",
            "sound_bridge",
            "sound_break",
            "dissolve",
            "fade",
            "scene_transition"
          ]
        },
        "trigger": {
          "$ref": "#/$defs/nonEmpty"
        },
        "editorial_gain": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "viewingDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_type",
        "owner_refs",
        "visible_subjects",
        "offscreen_subjects",
        "reading_priority",
        "framing_intent",
        "camera_response",
        "frame_axis",
        "aspect_ratio_fit",
        "reason"
      ],
      "properties": {
        "owner_type": {
          "enum": ["subject", "relationship", "object", "space", "subjective", "unresolved"]
        },
        "owner_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "visible_subjects": {
          "$ref": "#/$defs/stringArray"
        },
        "offscreen_subjects": {
          "$ref": "#/$defs/stringArray"
        },
        "reading_priority": {
          "enum": ["space", "relationship", "body", "face", "detail", "unresolved"]
        },
        "framing_intent": {
          "enum": ["single", "two_shot", "group", "over_shoulder", "insert", "subjective", "space", "unresolved"]
