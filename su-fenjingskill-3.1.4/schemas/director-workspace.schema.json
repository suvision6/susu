          "enum": ["observe", "isolate", "reframe", "follow", "reveal", "withhold", "unresolved"]
        },
        "frame_axis": {
          "enum": ["horizontal", "vertical", "depth", "layered", "centered", "diagonal", "subjective", "unresolved"]
